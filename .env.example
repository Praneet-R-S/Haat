# PayPal sandbox app (developer.paypal.com > Apps & Credentials > Sandbox > your app)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
# Optional: set after the first boot on a public https URL prints the registered webhook id
PAYPAL_WEBHOOK_ID=

# Google Gemini (aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.8-flash,gemini-3.1-flash-lite

# Public https URL when deployed (used for PayPal return URLs and webhook registration)
PUBLIC_URL=
PORT=8787
# Optional guard for POST /api/demo/reset on a hosted demo
DEMO_RESET_TOKEN=

# paypal = PayPal Payouts (marketplace account outside India); upi = UPI split from the cooperative (Indian PayPal accounts cannot send payouts); auto = learn from the first refusal
PAYOUT_MODE=auto
